<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <!-- Current: expires May 15, 2024 -->
      <certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
      <!-- Next -->
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
      <!-- For some very old MS packages -->
      <certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
    </repository>
    <!-- signatureValidationMode=require rejects any package whose signature has no matching entry
         here. SampleWeb.Client needs Microsoft.NET.Sdk.WebAssembly.Pack, which the .NET SDK serves
         from its own C:\Program Files\dotnet\library-packs folder; packs from there are AUTHOR
         signed by Microsoft rather than REPOSITORY signed by nuget.org, so the entry above cannot
         cover them and restore fails with NU3034.
         Microsoft rotates this certificate and announces each new one on the .NET blog (the 2026
         one: https://devblogs.microsoft.com/dotnet/microsoft-author-signing-certificate-update-2026/).
         Keep the old fingerprints, so packs signed before a rotation still restore.
         The newest certificate expires 2027-12-03. To add its successor, run
         "dotnet nuget trust certificate microsoft <fingerprint>" with the algorithm option set to
         SHA256 and the configfile option pointed at this file. "dotnet nuget trust author" cannot
         do it: it fails because a signer named microsoft already exists. Check the fingerprint
         against the SHA256 hash "dotnet nuget verify <path-to-pack>.nupkg -v n" prints. -->
    <author name="microsoft">
      <certificate fingerprint="3F9001EA83C560D712C24CF213C3D312CB3BFF51EE89435D3430BD06B5D0EECE"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
      <certificate fingerprint="AA12DA22A49BCE7D5C1AE64CC1F3D892F150DA76140F210ABD2CBFFCA2C18A27"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
      <certificate fingerprint="566A31882BE208BE4422F7CFD66ED09F5D4524A5994F50CCC8B05EC0528C1353"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
      <certificate fingerprint="9A1B131BEE0605433056A4EA3815478A8E177961A968C6C0027C1093D1FEB630"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
    </author>
  </trustedSigners>
</configuration>